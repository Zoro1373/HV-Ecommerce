# VERTEX Frontend Environment Configuration Template
# Copy this file to .env.local to customize your local development settings.
# Do NOT commit .env.local or sensitive secrets to git.

# Backend API Base URL (Used when mock mode is disabled)
REACT_APP_API_URL=http://localhost:5000

# Frontend-Only Development Mock Mode
# Set to 'true' to develop and test the entire React UI without requiring a running backend or Neon PostgreSQL database.
# Note: Mock mode is strictly guarded and automatically disabled in production builds (npm run build).
REACT_APP_USE_MOCK_API=false

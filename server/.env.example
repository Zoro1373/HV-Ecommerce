# ==============================================================================
# VERTEX E-Commerce Backend Environment Configuration
# ==============================================================================
# Copy this file to .env (e.g., `cp .env.example .env`) and fill in your values.
# NEVER commit the real .env file or database credentials to Git!
# ==============================================================================

# Node runtime environment (development, test, production)
NODE_ENV=development

# Port for the Express REST API
PORT=5000

# Frontend origin URL for CORS and cookie trust
FRONTEND_URL=http://localhost:3000

# ==============================================================================
# Database Connections (Least-Privilege Role Separation)
# ==============================================================================
# 1. Runtime Application Connection: Restricted DML role (e.g. vertex_app) via Neon Connection Pooler
DATABASE_URL="postgresql://vertex_app:APP_PASSWORD@ep-patient-flower-b4y82qxp-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# 2. Migration & Admin Connection: Full DDL role (e.g. neondb_owner) via Neon Direct Connection
DIRECT_URL="postgresql://neondb_owner:OWNER_PASSWORD@ep-patient-flower-b4y82qxp.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Secret key for signing session cookies
SESSION_SECRET="replace-with-a-random-32-byte-hex-string-for-session-security"

# Dedicated 256-bit AES-256-GCM encryption key for TOTP secrets (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
MFA_ENCRYPTION_KEY="replace-with-a-random-32-byte-hex-string-for-mfa-encryption"

# Optional comma-separated list of roles that require mandatory MFA (e.g. ADMIN or ADMIN,B2B)
MFA_ENFORCED_ROLES=

# Cookie domain (leave empty for localhost in development)
COOKIE_DOMAIN=

# Optional initial admin credentials for CLI seed (npm run seed:admin)
ADMIN_EMAIL=admin@vertex.in
ADMIN_PASSWORD=change_this_to_a_secure_temporary_password
ADMIN_NAME="VERTEX Admin"
